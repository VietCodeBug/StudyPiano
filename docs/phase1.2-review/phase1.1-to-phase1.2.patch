+    private fun prepareRestoreOperation(staging: File, expected: Map<String, String?>): File {
+        val op = File(context.filesDir, "song_operations/restore_${UUID.randomUUID()}").apply { mkdirs() }
+        try {
+            File(op, "operation.properties").writeText("kind=RESTORE\n")
+            File(op, "expected.tsv").writeText(expected.entries.joinToString("\n") { "${it.key}\t${it.value.orEmpty()}" })
+            val newSongs = File(op, "newSongs").apply { mkdirs() }
+            val newRecordings = File(op, "newRecordings").apply { mkdirs() }
+            if (File(staging, "files/songs").exists() && !File(staging, "files/songs").copyRecursively(newSongs, overwrite = false)) {
+                throw IOException("Failed to stage restored song files")
+            }
+            if (File(staging, "files/recordings").exists() && !File(staging, "files/recordings").copyRecursively(newRecordings, overwrite = false)) {
+                throw IOException("Failed to stage restored recording files")
+            }
+            faultInjector.onCheckpoint(RestoreCheckpoint.FILES_PREPARED)
+            return op
+        } catch (error: Throwable) {
+            op.deleteRecursively()
+            throw error
+        }
+    }
+
+    private fun swapRestoreFiles(op: File) {
+        val songs = File(context.filesDir, "songs")
+        val recordings = File(context.filesDir, "recordings")
+        if (songs.exists() && !songs.renameTo(File(op, "oldSongs"))) throw IOException("Failed to preserve current song files")
+        if (recordings.exists() && !recordings.renameTo(File(op, "oldRecordings"))) {
+            val restoredSongs = File(op, "oldSongs").let { !it.exists() || it.renameTo(songs) }
+            if (!restoredSongs) throw IOException("Failed to preserve recordings and failed to restore current songs; journal retained")
+            throw IOException("Failed to preserve current recording files; current songs restored")
+        }
+        if (!File(op, "newSongs").renameTo(songs) || !File(op, "newRecordings").renameTo(recordings)) {
+            rollbackRestoreFiles(op)
+            throw IOException("Failed to promote restored files; old files retained in restore journal")
+        }
+        File(op, "state").writeText("FILES_SWAPPED")
+    }
+
+    private suspend fun reconcileRestore(op: File, expected: Map<String, String?>) {
+        val actual = database.importedSongDao().getAllSongsList().associate { it.id to it.fileHashSha256 }
+        if (actual == expected) {
+            op.deleteRecursively()
+        } else if (!rollbackRestoreFiles(op)) {
+            throw IOException("Restore rollback could not replace active files; durable restore journal was retained")
+        }
+    }
+
+    private fun rollbackRestoreFiles(op: File): Boolean {
+        val songs = File(context.filesDir, "songs")
+        val recordings = File(context.filesDir, "recordings")
+        val failedSongs = File(op, "failedNewSongs")
+        val failedRecordings = File(op, "failedNewRecordings")
+        if (songs.exists() && !songs.renameTo(failedSongs)) return false
+        if (recordings.exists() && !recordings.renameTo(failedRecordings)) return false
+        val oldSongs = File(op, "oldSongs")
+        val oldRecordings = File(op, "oldRecordings")
+        if (oldSongs.exists() && !oldSongs.renameTo(songs)) return false
+        if (oldRecordings.exists() && !oldRecordings.renameTo(recordings)) return false
+        op.deleteRecursively()
+        return true
+    }
+
+    private fun sha256(file: File): String = file.inputStream().use { input ->
+        val digest = MessageDigest.getInstance("SHA-256")
+        val buffer = ByteArray(64 * 1024)
+        while (true) { val read = input.read(buffer); if (read < 0) break; digest.update(buffer, 0, read) }
+        digest.digest().joinToString("") { "%02x".format(it) }
+    }
