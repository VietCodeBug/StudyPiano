+    private fun File.isSupportedAudio(): Boolean = inputStream().use { input ->
+        val header = ByteArray(12); val count = input.read(header)
+        if (count < 4) return@use false
+        val text4 = header.copyOfRange(0, 4).toString(Charsets.ISO_8859_1)
